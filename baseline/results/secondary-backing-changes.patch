+def execution_blockers(option: dict) -> list[str]:
+    """Limit execution to the implemented rail/return adapter, not mere stock fit."""
+    errors = []
+    if option.get("topology_archetype") != "HORIZONTAL_BACKING_RAILS_WITH_JAMB_RETURNS":
+        errors.append("UNSUPPORTED_EXECUTION_TOPOLOGY")
+    roles = {row.get("role") for row in option.get("new_member_geometry", [])}
+    if roles - {"SECONDARY_BACKING_RAIL", "SECONDARY_BACKING_RETURN"}:
+        errors.append("UNSUPPORTED_MEMBER_ROLE")
+    tokens = [row.get("member_token") for row in option.get("new_member_geometry", [])]
+    if not tokens or len(tokens) != len(set(tokens)):
+        errors.append("EMPTY_OR_DUPLICATE_MEMBER_TOKENS")
+    for row in option.get("panel_attachment_map", []):
+        if row.get("host_member_token") not in tokens:
+            errors.append("UNSUPPORTED_PANEL_ATTACHMENT_MAP")
+    return sorted(set(errors))
+
+
+def require_executable(option: dict) -> None:
+    errors = execution_blockers(option)
+    if errors:
+        raise ValueError("OPTION_NOT_EXECUTABLE: " + ",".join(errors))
+
